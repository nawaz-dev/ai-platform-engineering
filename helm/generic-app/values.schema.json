{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 0},
    "image": {"type": "object", "required": ["repository"], "properties": {"repository": {"type": "string", "minLength": 1}, "tag": {"type": "string"}}},
    "serviceAccount": {"type": "object", "properties": {"create": {"type": "boolean"}, "automountServiceAccountToken": {"type": "boolean"}}},
    "persistentVolumeClaims": {"type": "array", "items": {"type": "object", "required": ["name", "size", "accessModes"], "properties": {"name": {"type": "string"}, "size": {"type": "string"}, "accessModes": {"type": "array", "minItems": 1}}}},
    "volumes": {"type": "array"},
    "volumeMounts": {"type": "array"},
    "initContainers": {"type": "array"},
    "extraContainers": {"type": "array"}
  }
}
